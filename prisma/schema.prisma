generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  name         String
  passwordHash String
  avatar       String         @default("U")
  color        String         @default("#94a3b8")
  glowColor    String         @default("rgba(148, 163, 184, 0.35)")
  accentBg     String         @default("rgba(148, 163, 184, 0.12)")
  role         String         @default("applicant")
  createdAt    DateTime       @default(now())
  outreach     OutreachRecord[]
  activityLogs ActivityLog[]
  professors   Professor[]
  bookmarks    ProfessorBookmark[]
  mastersCourses MastersCourse[]
  mastersBookmarks MastersCourseBookmark[]
  scholarships   Scholarship[]
}

model University {
  id          String       @id @default(cuid())
  name        String
  country     String
  city        String       @default("")
  ranking     Int?
  portalUrl   String?
  websiteUrl  String?
  notes       String?
  createdAt   DateTime     @default(now())
  departments Department[]

  @@index([country])
}

model Department {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  degreeLevel  String     @default("PhD")
  websiteUrl   String?
  deadlines    Json?
  requirements Json?
  createdAt    DateTime   @default(now())
  professors   Professor[]

  @@index([universityId])
}

model Professor {
  id                String           @id @default(cuid())
  departmentId      String
  department        Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name              String
  title             String           @default("Professor")
  email             String           @default("")
  websiteUrl        String?
  scholarUrl        String?
  researchAreas     String[]         @default([])
  acceptingStudents String           @default("unknown")
  notes             String?
  visibility        String           @default("public")
  ownerId           String?
  owner             User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  outreach          OutreachRecord[]
  bookmarks         ProfessorBookmark[]

  @@index([departmentId])
  @@index([ownerId])
}

model ProfessorBookmark {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  professorId String
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, professorId])
  @@index([professorId])
}

model MastersCourse {
  id              String   @id @default(cuid())
  universityName  String
  departmentName  String
  ieltsReq        String   @default("")
  lastDate        String   @default("")
  applicationLink String   @default("")
  description     String   @default("")
  visibility      String   @default("private")
  ownerId         String?
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookmarks       MastersCourseBookmark[]

  @@index([ownerId])
  @@index([visibility])
}

model MastersCourseBookmark {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    MastersCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    String        @default("interested")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model Scholarship {
  id              String   @id @default(cuid())
  title           String
  organization    String   @default("")
  degreeLevel     String   @default("")
  amount          String   @default("")
  deadline        String   @default("")
  country         String   @default("")
  applicationLink String   @default("")
  description     String   @default("")
  visibility      String   @default("private")
  ownerId         String?
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([visibility])
}

model OutreachRecord {
  id           String    @id @default(cuid())
  professorId  String
  professor    Professor @relation(fields: [professorId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("not_contacted")
  dateEmailed  String?
  responseDate String?
  followUpDate String?
  notes        String?
  emailSubject String?
  lastUpdated  DateTime  @default(now())

  @@unique([professorId, userId])
  @@index([userId])
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp   DateTime @default(now())
  action      String
  description String
  metadata    Json?

  @@index([userId])
}
